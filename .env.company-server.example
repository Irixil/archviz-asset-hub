# Copy this file to .env on the company application server.
PORT=8080
MAIL_PORT=2525
BASE_URL=http://company-asset-server:8080

# Host directory mounted by docker-compose.yml at /data.
ARCHVIZ_DATA_PATH=/srv/archviz

DB_PATH=/data/damask.db

# Store originals on the directory exported to employees through SMB.
STORAGE=local
STORAGE_LOCAL_PATH=/data/storage

ENABLE_SIGNUP=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_SECRET=replace-with-a-different-random-secret-at-least-32-characters

APP_ENV=production
LOG_LEVEL=INFO
ENABLE_SCHEDULER=true
QUEUE_WORKERS=4
OTEL_ENABLED=false

# Windows desktop clients must map the same directory, for example:
# ARCHVIZ_SERVER_URL=http://company-asset-server:8080/library
# ARCHVIZ_STORAGE_ROOT=\\company-asset-server\素材库\storage
